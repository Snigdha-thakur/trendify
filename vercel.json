{
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm --prefix frontend install",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://trendify-pxkx.onrender.com/api/:path*"
    },
    {
      "source": "/user/dashboard",
      "destination": "/user-dashboard.html"
    },
    {
      "source": "/user/dashboard.html",
      "destination": "/user-dashboard.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin-:path*.html"
    },
    {
      "source": "/creator/:path*",
      "destination": "/creator-:path*.html"
    },
    {
      "source": "/user/:path*",
      "destination": "/user-:path*.html"
    }
  ]
}
